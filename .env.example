# Public Supabase project values from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SECRET_KEY=
SUPABASE_DEMO_PASSWORD=

# Optional demo account email overrides. Passwords remain server-only above.
SUPABASE_DEMO_PATIENT_EMAIL=patient@nightingale.demo
SUPABASE_DEMO_STAFF_EMAIL=staff@nightingale.demo
SUPABASE_DEMO_CLINICIAN_EMAIL=clinician@nightingale.demo
SUPABASE_DEMO_ADMIN_EMAIL=admin@nightingale.demo
SUPABASE_DEMO_CLINIC_B_EMAIL=clinician-b@nightingale.demo
SUPABASE_DEMO_QA_PATIENT_EMAIL=qa-patient@nightingale.demo

# The shipped runtime uses the deterministic provider and requires no external AI key.
